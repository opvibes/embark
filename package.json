{
  "name": "embark",
  "version": "1.5.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "git submodule foreach --recursive git checkout -- . && git submodule update --init --recursive --remote && git config submodule.recurse true",
    "prepare": "husky",
    "postinstall": "husky",
    "test": "bun test --coverage scripts/__tests__",
    "start": "bun scripts/utils.ts",
    "setup": "bun scripts/setup.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/bun": "^1.3.9",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.9"
}